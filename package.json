{
  "name": "shape-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup-assets.mjs",
    "predev": "npm run setup",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "npm run setup",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:video": "playwright test --config playwright.video.config.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
